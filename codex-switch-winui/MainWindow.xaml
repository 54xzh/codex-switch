<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="codex_switch_winui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:codex_switch_winui"
    xmlns:models="using:codex_switch_winui.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Codex Switch">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="{StaticResource LargeMargin}" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,24"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="Codex 账号/Base URL 快速切换" />

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: List -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False" OverflowButtonVisibility="Collapsed" HorizontalAlignment="Left" Margin="-14,0,-14,0">
                    <AppBarButton Click="Add_Click" Label="添加" ToolTipService.ToolTip="添加新配置">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE710;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Click="Delete_Click" Label="删除" ToolTipService.ToolTip="删除选中配置">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Click="Refresh_Click" Label="刷新" ToolTipService.ToolTip="刷新列表">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Click="Edit_Click" Label="编辑" ToolTipService.ToolTip="编辑选中配置">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE70F;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Padding="4">
                    <ListView
                        x:Name="ProfilesList"
                        DoubleTapped="ProfilesList_DoubleTapped"
                        ItemsSource="{x:Bind Profiles, Mode=OneWay}"
                        SelectedItem="{x:Bind SelectedProfile, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CodexProfile">
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                                    <FontIcon Glyph="&#xE77B;" FontSize="16" Opacity="0.6" />
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- Right Column: Details -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /> 
                </Grid.RowDefinitions>

                <!-- Top Actions (Moved from bottom) -->
                 <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False" OverflowButtonVisibility="Collapsed" HorizontalAlignment="Left" Margin="-14,0,0,0">
                    <AppBarButton Click="Switch_Click" Label="切换到此组合" Style="{StaticResource AppBarButtonRevealStyle}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE71C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Click="RestoreLatestBackup_Click" Label="恢复备份">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE777;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                     <AppBarSeparator />
                    <AppBarButton Click="OpenCodexFolder_Click" Label="目标目录">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                     <AppBarButton Click="OpenBackupsFolder_Click" Label="备份目录">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Click="EditTemplates_Click" Label="模板">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Click="Settings_Click" Label="设置">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>

                <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Top">
                    <!-- Detail Card -->
                    <Grid Style="{StaticResource CardGridStyle}" Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Text="{x:Bind SelectedProfileName, Mode=OneWay, TargetNullValue='(未选择)'}" 
                                    VerticalAlignment="Center"/>
                            </StackPanel>

                            <MenuFlyoutSeparator />

                            <Grid ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Opacity="0.6" Text="Base URL" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" Text="{x:Bind SelectedProfileBaseUrl, Mode=OneWay}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Margin="-10,0,0,0" Padding="10,6,6,6" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Opacity="0.6" Text="认证方式" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind SelectedProfileAuthModeText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Medium" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Opacity="0.6" Text="提供商" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind SelectedProfileProviderCategoryText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Medium" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Session Migration Settings -->
                    <Grid Style="{StaticResource CardGridStyle}" Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="替换目标" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <CheckBox
                                        x:Name="ReplaceWindowsTargetCheckBox"
                                        Checked="ReplaceTargetCheckBox_Changed"
                                        Content="Windows"
                                        Unchecked="ReplaceTargetCheckBox_Changed" />
                                    <CheckBox
                                        x:Name="ReplaceWslTargetCheckBox"
                                        Checked="ReplaceTargetCheckBox_Changed"
                                        Content="WSL"
                                        Unchecked="ReplaceTargetCheckBox_Changed" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="WslTargetStatusTextBlock"
                                    FontSize="12"
                                    Opacity="0.6"
                                    Text="WSL 未启用。"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5" />

                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="会话迁移天数" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox
                                        x:Name="SessionMigrationDaysBox"
                                        Width="120"
                                        Minimum="0"
                                        Maximum="30"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="SessionMigrationDaysBox_ValueChanged" />
                                    <TextBlock Opacity="0.6" VerticalAlignment="Center" Text="0 表示关闭" />
                                </StackPanel>
                                <TextBlock Opacity="0.6" FontSize="12" Text="切换组合时，会同步迁移最近 N 天 sessions 和 state_5.sqlite 中的 model_provider。" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
